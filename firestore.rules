rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== v2.59.5: 管理員白名單 =====
    // 以前只檢查「有沒有登入」，任何人自建帳號就能改刪全校預約。
    // 現在只有白名單 Email（且非匿名登入）才算管理員；要新增管理員請改這裡與 app.js 的 ADMIN_EMAILS。
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() in ['ipad@mail2.smes.tyc.edu.tw']
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /bookings/{booking} {
      // 所有人可讀取預約資料
      allow read: if true;
      
      // 新增預約：完整欄位驗證
      allow create: if isValidBooking();
      
      // 更新：管理員 或 原裝置老師自行取消 (只能減少節次，不能改人名/場地/日期/事由)
      allow update: if isAdmin() || isOwnerCancel();
      
      // 刪除：僅限管理員
      allow delete: if isAdmin();

      function isOwnerCancel() {
        let before = resource.data;
        let after = request.resource.data;
        return ('deviceId' in before)
          && after.deviceId == before.deviceId
          && after.diff(before).affectedKeys().hasOnly(['periods'])
          && after.periods is list
          && after.periods.size() <= before.periods.size()
          && before.periods.hasAll(after.periods);
      }
      
      // ===== 驗證函數 =====
      function isValidBooking() {
        let data = request.resource.data;
        return 
          // 必填欄位存在性
          data.keys().hasAll(['booker', 'date', 'periods', 'reason', 'room'])
          // 欄位數量限制（防止惡意欄位注入）— v2.49.2 新增 batchId 欄位 → 上限 9
          && data.keys().size() <= 9
          // booker 驗證：字串、非空、長度限制
          && data.booker is string
          && data.booker.size() >= 1
          && data.booker.size() <= 50
          // room 驗證：字串、非空、長度限制
          && data.room is string
          && data.room.size() >= 1
          && data.room.size() <= 50
          // date 驗證：字串、格式 YYYY/MM/DD
          && data.date is string
          && data.date.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$')
          // periods 驗證：陣列、非空、最多10個節次
          && data.periods is list
          && data.periods.size() >= 1
          && data.periods.size() <= 10
          // reason 驗證：字串、長度限制
          && data.reason is string
          && data.reason.size() <= 200
          // createdAt 驗證（若存在）
          && (!('createdAt' in data.keys()) || data.createdAt == request.time)
          // deviceId 驗證（Rate Limiting 用）
          && (!('deviceId' in data.keys()) || (data.deviceId is string && data.deviceId.size() <= 64))
          // v2.49.2: batchId (用於批次/重複預約 LINE 通知彙整)
          && (!('batchId' in data.keys()) || (data.batchId is string && data.batchId.size() <= 64));
      }
    }

    match /roomSettings/{settingId} {
      // 所有人可讀取場地設定 (用以視覺化不開放時段)
      allow read: if true;
      // 僅限管理員可建立與更新
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      // 允許任何人新增日誌 (包含未登入的使用者操作，如訪客嘗試登入失敗、自刪預約)
      allow create: if true;
      // 僅限管理員讀取日誌
      allow read: if isAdmin();
      // 禁止修改與刪除日誌 (確保稽核完整性)
      allow update, delete: if false;
    }

    // ===== v2.44.0 (1.1): LINE 綁定碼 (僅 Cloud Function 可寫,前端可讀以驗證) =====
    match /lineBindingCodes/{code} {
      // 只能由 Cloud Function 寫入 (前端透過 createBindingCode API)
      allow write: if false;
      // 前端可讀取以輪詢狀態 (僅自己的 deviceId)
      allow read: if true;
    }

    // ===== v2.44.0 (1.1): LINE 綁定關係 =====
    match /lineBindings/{deviceId} {
      // 只能由 Cloud Function 寫入 (透過 lineWebhook 處理綁定)
      allow write: if false;
      // 前端可讀取以判斷是否已綁定 (僅自己的 deviceId)
      allow read: if true;
    }

    // ===== v2.46.0 (Phase 3): 管理員告警訂閱者 =====
    match /adminLineRecipients/{lineUserId} {
      // 只能由 Cloud Function 寫入 (透過 subscribeAdminAlerts API)
      allow write: if false;
      // 僅管理員可讀取訂閱清單
      allow read: if isAdmin();
    }

    // ===== v2.49.1: 教室預約通知訂閱者 (管理員專用) =====
    match /roomWatchers/{lineUserId} {
      // 只能由 Cloud Function 寫入 (透過 subscribeRoomWatch API)
      allow write: if false;
      // 僅管理員可讀取訂閱清單
      allow read: if isAdmin();
    }

    // ===== v2.49.2: 批次預約通知去重鎖 (僅 Cloud Function 使用) =====
    match /notificationLocks/{lockId} {
      // 前端完全無法存取 — 純 Cloud Function 內部去重機制
      allow read, write: if false;
    }

    // ===== v2.52.0 (T.2): Sentry 告警去重鎖 (僅 Cloud Function 使用) =====
    match /sentryAlerts/{alertId} {
      // 前端完全無法存取 — 純 Cloud Function sentryWebhook 內部去重機制
      allow read, write: if false;
    }

    // ===== v2.54.0 (P1-3): 預約編輯歷史 (僅 Cloud Function 寫入) =====
    match /editTrail/{trailId} {
      // 僅管理員可讀 (含 deviceId 等資訊)
      allow read: if isAdmin();
      // 只能由 Cloud Function trackBookingChanges 寫入
      allow write: if false;
    }

    // ===== v2.53.0 (P1-5): 通知偏好 (on/off 布林, 非敏感) =====
    match /notifPrefs/{deviceId} {
      // 前端讀取自己的偏好以顯示勾選狀態 (內容僅 on/off, 無敏感資訊)
      allow read: if true;
      // 寫入強制 deviceId == 文件 key
      allow create, update: if request.resource.data.deviceId == deviceId
        && request.resource.data.deviceId is string
        && request.resource.data.keys().size() <= 5;
      allow delete: if true;
    }

    // ===== v2.53.0 (P1-1): Web Push 訂閱 =====
    match /webPushSubscriptions/{deviceId} {
      // 僅 Cloud Function 讀取 (發送推播); 前端不可讀他人訂閱
      allow read: if false;
      // 前端可寫入自己的訂閱 (deviceId 必須等於文件 key)
      allow create, update: if request.resource.data.deviceId == deviceId
        && request.resource.data.deviceId is string
        && request.resource.data.keys().size() <= 5;
      // 允許取消訂閱 (刪除自己的; deviceId 為 key, 不易被猜)
      allow delete: if true;
    }

    // ===== v2.46.0 (Phase 3): 排程提醒去重表 =====
    match /sentReminders/{reminderId} {
      // 只能由 Cloud Function (scheduledReminder) 寫入
      allow write: if false;
      // 僅管理員可讀取
      allow read: if isAdmin();
    }

    // ===== v2.47.0: 老師意見回饋 =====
    match /feedbacks/{feedbackId} {
      // 只能由 Cloud Function (submitFeedback) 寫入
      allow create: if false;
      // 僅管理員可讀寫 (修改 status 等)
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // ===== v2.41.0 (M.1): 場地維護公告 =====
    match /roomAnnouncements/{annId} {
      // 所有人可讀取公告 (預約彈窗會顯示)
      allow read: if true;
      // 僅管理員可建立、更新、刪除
      allow create: if isAdmin() && isValidAnnouncement();
      allow update: if isAdmin() && isValidAnnouncement();
      allow delete: if isAdmin();

      function isValidAnnouncement() {
        let data = request.resource.data;
        return
          data.keys().hasAll(['room', 'message', 'startDate', 'endDate', 'importance'])
          && data.keys().size() <= 10
          && data.room is string && data.room.size() <= 50
          && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
          && data.startDate is string
          && data.startDate.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$')
          && data.endDate is string
          && data.endDate.matches('^[0-9]{4}/[0-9]{2}/[0-9]{2}$')
          && data.importance in ['info', 'warning', 'critical']
          && (!('lockBookings' in data.keys()) || data.lockBookings is bool);
      }
    }
  }
}
