rules_version = '2';

// Cloud Storage Security Rules for 禮堂&專科教室預約系統
// v2.48.0: AI 學期白皮書 (HTML 報告儲存於 reports/ 路徑)
service firebase.storage {
  match /b/{bucket}/o {
    // 報告不提供公開下載；管理員透過後端驗證後讀取，僅 Cloud Functions 可寫
    match /reports/{file=**} {
      allow read: if false; // 僅透過驗證管理員的後端讀取，不產生下載 token
      allow write: if false; // 僅後端 Admin SDK 可寫
    }

    // 預設拒絕其他所有路徑
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
